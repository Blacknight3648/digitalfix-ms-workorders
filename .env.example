# ==========================================================
# Variables de entorno - digitalfix-ms-workorders
# ==========================================================
# Plantilla SIN valores reales. Copiala como ".env" en la raiz del
# proyecto y completa los valores (pidelos al equipo por un canal
# privado, nunca por el repo):
#
#   cp .env.example .env        (Windows: copy .env.example .env)
#
# ".env" esta en .gitignore y NUNCA debe subirse al repositorio.
# Spring Boot lo lee solo al arrancar (spring.config.import en
# application.yaml) y docker compose lo usa para sustituir ${...}.
# ==========================================================

# --- Base de datos Oracle Autonomous (con wallet) ---
# TNS_ADMIN=./wallet apunta a la carpeta "wallet" de la raiz del
# proyecto (ver README > Wallet de Oracle). El alias "_high" sale
# del archivo wallet/tnsnames.ora.
SPRING_DATASOURCE_URL=jdbc:oracle:thin:@<alias_de_tnsnames>_high?TNS_ADMIN=./wallet
SPRING_DATASOURCE_USERNAME=<usuario_bd>
SPRING_DATASOURCE_PASSWORD=<contrasena_bd>

# --- CORS ---
# Origen(es) del frontend permitidos, separados por coma.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Puerto local (solo al correr con mvnw / IDE) ---
# Usa otro si el 8080 esta ocupado (XAMPP/Apache, ms-login, etc.).
SERVER_PORT=8081

# --- Puerto publicado en el host por docker compose ---
# Dentro del contenedor la app siempre escucha en 8080.
# En EC2 debe estar abierto en el Security Group.
APP_PORT=8081

# --- Opciones de la JVM (opcional, solo Docker) ---
JAVA_OPTS=-Xms256m -Xmx512m

# --- RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=admin123
RABBITMQ_VIRTUAL_HOST=/
