# ==========================================================
# Variables de entorno - digitalfix-ms-workorders
# ==========================================================
# Copia este archivo como ".env" (en local o directamente en el
# servidor EC2, dentro de la carpeta del proyecto) y completa los
# valores reales. El archivo ".env" esta en .gitignore (*.env) y
# NUNCA debe subirse al repositorio.
#
#   cp .env.example .env
#
# En produccion (EC2), este archivo se crea UNA sola vez a mano en
# el servidor. El pipeline de GitHub Actions no lo toca ni lo
# sobreescribe en cada despliegue.
# ==========================================================

# --- Base de datos Oracle ---
# Si Oracle corre en el mismo EC2 (contenedor "oracle-db" levantado
# por digitalfix-ms-login, red "digitalfix-net"), deja el host como
# "oracle-db". Si es una base externa (RDS, servidor propio, etc.)
# usa su host/IP real.
SPRING_DATASOURCE_URL=jdbc:oracle:thin:@//oracle-db:1521/FREEPDB1
SPRING_DATASOURCE_USERNAME=system
SPRING_DATASOURCE_PASSWORD=CAMBIA_ESTA_CONTRASENA

# --- CORS ---
# Origen(es) del frontend permitidos, separados por coma.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Puerto publicado en el host EC2 ---
# Puerto por el que se expone el servicio hacia afuera del contenedor.
# Debe estar abierto en el Security Group de la instancia EC2.
APP_PORT=8081

# --- Opciones de la JVM (opcional) ---
JAVA_OPTS=-Xms256m -Xmx512m
